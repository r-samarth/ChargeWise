VITE_API_BASE_URL=http://localhost:8001/api/v1
# Optional custom raster tile template (defaults to keyless OpenStreetMap tiles)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Firebase Web SDK Configuration (public identifiers only — never place Admin credentials here)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chargewise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-chargewise
VITE_FIREBASE_STORAGE_BUCKET=demo-chargewise.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:chargewise

# Local Firebase Emulators (set to false in production)
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8085
