# Application
APP_NAME=ChargeWise API
APP_ENV=development
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg://chargewise:chargewise_dev_pass@localhost:5432/chargewise

# Firebase Admin SDK & Emulators
FIREBASE_PROJECT_ID=demo-chargewise
# Production: set FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS (never commit JSON files)
FIREBASE_CHECK_REVOKED=false
# Local Emulator hosts (comment out for production Firebase)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# External Routing / Elevation / Data APIs
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OCM_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
